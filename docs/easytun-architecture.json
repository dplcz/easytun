  "cards": [
    {
      "dot": "cyan",
      "title": "客户端分级（L0 → L4）",
      "items": [
        "L0 应用流量 → L1 虚拟网卡与无锁通道",
        "L2 GamePacket 封装与 LZ4 智能压缩",
        "L3 Noise IK 会话 + ChaCha20-Poly1305 加密",
        "L4 UDP 数据面与 WebSocket 控制面双通道"
      ]
    },
    {
      "dot": "emerald",
      "title": "服务端分级（S1 → S6）",
      "items": [
        "S1 控制面接入 → S2 握手、虚拟 IP 与 hostname.et 登记",
        "S3 ReadBatch 收包 → S4 中转路由 → S6 WriteBatch 下发",
        "S5 Check 端口接收刷新包，辅助对称 NAT 端口预测"
      ]
    },
    {
      "dot": "violet",
      "title": "共享状态（无锁读）",
      "items": [
        "routerSnapshot 与 dnsMap 均为写时复制原子快照",
        "TunnelManager 记录隧道状态与重试次数（上限 6 次）",
        "IP 池与 ClientID 保留期支持断线重连后复用地址与域名"
      ]
    },
    {
      "dot": "amber",
      "title": "两种数据流通状态",
      "items": [
        "中继态：客户端 → 服务端 UDP → 中转 → 对端",
        "直连态：打洞成功后数据面旁路服务端，控制面仍保持",
        "载荷全程端到端加密，服务端不持有会话密钥"
      ]
    }
  ]
}
