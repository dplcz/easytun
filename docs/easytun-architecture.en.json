  "cards": [
    {
      "dot": "cyan",
      "title": "Client stages (L0 → L4)",
      "items": [
        "L0 application traffic → L1 virtual NIC and lock-free channels",
        "L2 GamePacket framing with LZ4 probe compression",
        "L3 Noise IK session plus ChaCha20-Poly1305 encryption",
        "L4 UDP data plane and WebSocket control plane side by side"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server stages (S1 → S6)",
      "items": [
        "S1 control ingress → S2 handshake, virtual IP, and hostname.et registration",
        "S3 ReadBatch receive → S4 relay routing → S6 WriteBatch send",
        "S5 Check port absorbs refresh packets to predict symmetric-NAT ports"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared state (lock-free reads)",
      "items": [
        "routerSnapshot and dnsMap are copy-on-write atomic snapshots",
        "TunnelManager tracks tunnel status and retry count (max 6)",
        "IP pool and ClientID retention let a reconnect reclaim its address and name"
      ]
    },
    {
      "dot": "amber",
      "title": "Two data-flow states",
      "items": [
        "Relay state: client → server UDP → relay routing → peer",
        "Direct state: after a successful punch the data plane bypasses the server",
        "Payloads stay end-to-end encrypted; the server holds no session keys"
      ]
    }
  ]
}
